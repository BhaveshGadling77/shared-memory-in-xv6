diff --git a/shm.c b/shm.c
new file mode 100644
index 0000000..fef1830
--- /dev/null
+++ b/shm.c
@@ -0,0 +1,212 @@
+#include "types.h"
+#include "defs.h"
+#include "param.h"
+#include "memlayout.h"
+#include "mmu.h"
+#include "spinlock.h"
+#include "shm.h"
+#include "proc.h"
+
+int shmget(int key, int size, int shmflg){
+  int i;
+  int j;
+  int npages;
+  int shmid;
+
+  if(size <= 0)
+    return -1;
+
+  npages = (size + PGSIZE - 1) / PGSIZE;
+
+  if(npages > SHM_MAX_PAGES) {
+    return -1;
+  }
+
+  acquire(&shm.lock);
+
+  // Check whether key already exists
+
+  for(i = 0; i < NSHM; i++){
+    if(shm.seg[i].used && shm.seg[i].key == key){
+      shmid = shm.seg[i].shmid;
+      release(&shm.lock);
+      return shmid;
+    }
+  }
+
+  // Segment doesn't exist
+ //  to check whetehr the flag ask to create that particular segment like 
+  if(!(shmflg & IPC_CREAT)){
+    release(&shm.lock);
+    return -1;
+  }
+
+  // Find free slot
+
+  for(i = 0; i < NSHM; i++){
+    if(!shm.seg[i].used)
+      break;
+  }
+
+  // here it means that no free slot is there like 
+  if(i == NSHM){
+    release(&shm.lock);
+    return -1;
+  }
+
+  // Allocate pages
+
+  for(j = 0; j < npages; j++){
+    shm.seg[i].pages[j] = kalloc();
+
+     // as during running all the global variables are initialized out to zero 
+    if(shm.seg[i].pages[j] == 0){
+
+      // deletion if allocation fails
+
+      while(j > 0){
+        j--;
+        kfree(shm.seg[i].pages[j]);
+      }
+
+      release(&shm.lock);
+      return -1;
+    }
+  }
+
+  // Fill metadata
+
+  shm.seg[i].used = 1;
+  shm.seg[i].key = key;
+  shm.seg[i].shmid = i + 1;
+  shm.seg[i].size = size;
+  shm.seg[i].npages = npages;
+  shm.seg[i].nattach = 0;
+
+  shmid = shm.seg[i].shmid;
+
+  release(&shm.lock);
+
+  return shmid;
+}
+
+void* shmat(int shmid, const void *shmaddr, int shmflg)
+{
+  
+  int i;
+  int j;
+  int k;
+  uint va;
+  int perm;
+
+  struct proc *p = myproc();
+  acquire(&shm.lock);
+
+  // first find the shm segment using loop
+  for (i = 0; i < NSHM; i++) {
+    if(shm.seg[i].used &&
+      shm.seg[i].shmid == shmid)
+      break;
+  }
+
+  //not found segment error
+  if (i == NSHM) {
+    release(&shm.lock);
+    return (void*)-1;
+  }
+  
+  // lets find if the any fixed virtual address is given or not.
+  if(shmaddr == 0) {
+    va = PGROUNDUP(p->sz);
+  } else {
+    va = PGROUNDDOWN((uint)shmaddr);
+  }
+
+  // shared memory should be user accessible and writable.
+  perm = PTE_W | PTE_U;
+
+  // map every page of the shared memory segment.
+  for(j = 0; j < shm.seg[i].npages; j++) {
+
+    uint pa = V2P(shm.seg[i].pages[j]);
+    //mappages internally check if the page is allocated to some other processes or not.
+    if(mappages(p->pgdir,
+                (void*)(va + j * PGSIZE),
+                PGSIZE,
+                pa,
+                perm) < 0) {
+
+      release(&shm.lock);
+      return (void*)-1;
+    }
+  }
+
+  // i am modifying code to not remove the shared memory page after child exits
+  // record this attachment in the process
+  for(k = 0; k < MAX_SHM_ATTACH; k++) {
+    if(!p->shmattach[k].used)
+      break;
+  }
+  
+  // no free attachment slot left
+  if(k == MAX_SHM_ATTACH) {
+    release(&shm.lock);
+    return (void*)-1;
+  }
+  p->shmattach[k].used = 1;
+  p->shmattach[k].shmid = shmid;
+  p->shmattach[k].va = va;
+
+  shm.seg[i].nattach++;
+
+  release(&shm.lock);
+
+  return (void*)va;
+}
+int
+is_shared_page(uint pa)
+{
+  int i;
+  int j;
+
+  acquire(&shm.lock);
+
+  for(i = 0; i < NSHM; i++) {
+    if(!shm.seg[i].used)
+      continue;
+
+    for(j = 0; j < shm.seg[i].npages; j++) {
+      if(V2P(shm.seg[i].pages[j]) == pa) {
+        release(&shm.lock);
+        return 1;
+      }
+    }
+  }
+
+  release(&shm.lock);
+  return 0;
+}
+
+int
+get_shm_segment(uint pa)
+{
+  int i;
+  int j;
+
+  acquire(&shm.lock);
+
+  for(i = 0; i < NSHM; i++) {
+    if(!shm.seg[i].used)
+      continue;
+
+    for(j = 0; j < shm.seg[i].npages; j++) {
+      if(V2P(shm.seg[i].pages[j]) == pa) {
+        release(&shm.lock);
+        return i;
+      }
+    }
+  }
+
+  release(&shm.lock);
+  return -1;
+}
diff --git a/shm.h b/shm.h
new file mode 100644
index 0000000..0a786ff
--- /dev/null
+++ b/shm.h
@@ -0,0 +1,31 @@
+#ifndef SHM_H
+#define SHM_H
+#include "spinlock.h"
+/*Flags for shmget*/
+#define IPC_CREAT 01000
+
+/*General limits for sengment*/
+#define NSHM 16
+#define SHM_MAX_PAGES 16
+
+/*flags for `shmat`*/
+#define SHM_RDONLY	010000		/* attach read-only else read-write */
+#define SHM_RND		020000		/* round attach address to SHMLBA */
+#define SHM_REMAP	040000		/* take-over region on attach */
+#define SHM_EXEC	0100000		/* execution access */
+
+struct shmseg {
+  int used;
+  int key;
+  int shmid;
+  int size;
+  int npages;
+  int nattach;
+  char *pages[SHM_MAX_PAGES];
+};
+
+struct {
+  struct spinlock lock;
+  struct shmseg seg[NSHM];
+} shm;
+#endif
diff --git a/shmattest.c b/shmattest.c
new file mode 100644
index 0000000..55935ea
--- /dev/null
+++ b/shmattest.c
@@ -0,0 +1,82 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+#include "shm.h"
+
+#define SHM_KEY 1234
+
+int
+main(void)
+{
+  int shmid;
+  int pid;
+  int *shared;
+
+  printf(1, "Creating shared memory...\n");
+
+  shmid = shmget(SHM_KEY, sizeof(int), IPC_CREAT);
+
+  if(shmid < 0) {
+    printf(1, "shmget failed\n");
+    exit();
+  }
+
+  printf(1, "Shared memory id = %d\n", shmid);
+
+  shared = (int*)shmat(shmid, 0, 0);
+
+  if(shared == (int*)-1) {
+    printf(1, "Parent shmat failed\n");
+    exit();
+  }
+
+  //parent shared value
+  *shared = 0;
+
+  printf(1, "Parent: initialized shared = %d\n", *shared);
+
+  pid = fork();
+
+  if(pid < 0) {
+    printf(1, "fork failed\n");
+    exit();
+  }
+
+  if(pid == 0) {
+    int *child_shared;
+
+    child_shared = (int*)shmat(shmid, 0, 0);
+
+    if(child_shared == (int*)-1) {
+      printf(1, "Child shmat failed\n");
+      exit();
+    }
+
+    printf(1, "Child: read shared = %d\n", *child_shared);
+
+    *child_shared = 100;
+
+    printf(1, "Child: wrote shared = %d\n", *child_shared);
+
+    sleep(20);
+
+    printf(1, "Child: after parent write = %d\n", *child_shared);
+
+    exit();
+
+  } else {
+    sleep(10); //because according to selection logic parent will always run first
+    printf(1, "Parent: after child write = %d\n", *shared);
+
+    *shared = 200;
+
+    printf(1, "Parent: wrote shared = %d\n", *shared);
+
+    wait();
+
+    printf(1, "Parent: final shared = %d\n", *shared);
+  }
+  
+  exit();
+  
+}
